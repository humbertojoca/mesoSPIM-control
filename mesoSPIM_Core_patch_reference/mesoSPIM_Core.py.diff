+    def _stage_poll_during_run_ms(self):
+        """ASI Tiger only: interval (ms) at which to KEEP polling stage positions while
+        live/snap/acquisition runs, from asi_dac_parameters['stage_poll_interval_ms_during_run'].
+        None (key absent / 0) = pause polling entirely (the confirmed-working default)."""
+        if getattr(self.cfg, 'waveformgeneration', None) != 'ASI_Tiger':
+            return None
+        ah = getattr(self.cfg, 'asi_dac_parameters', None)
+        ms = ah.get('stage_poll_interval_ms_during_run') if isinstance(ah, dict) else None
+        return int(ms) if ms else None
+
+    def _stage_polling_pause(self):
+        """Replaces the stock 'stop polling during acquisition' emit. With an ASI Tiger
+        and stage_poll_interval_ms_during_run set, polling continues but SLOWLY
+        (one cheap 'W <axes>' query per interval) so the GUI keeps showing correct
+        positions; otherwise polling stops exactly as in stock mesoSPIM."""
+        ms = self._stage_poll_during_run_ms()
+        if ms:
+            self.sig_polling_stage_position_set_interval.emit(ms)
+            self._pos_poll_throttled = True
+            self.sig_polling_stage_position_start.emit()
+        else:
+            self.sig_polling_stage_position_stop.emit()
+
+    def _stage_polling_pause_for_live(self):
+        """snap()/live(): stock mesoSPIM never paused polling here, so only the ASI Tiger
+        backend (shared serial port) does -- NI/Demo users keep stock behaviour."""
+        if getattr(self.cfg, 'waveformgeneration', None) == 'ASI_Tiger':
+            self._stage_polling_pause()
+
+    def _stage_polling_resume(self):
+        """Back to normal-rate polling (restores the interval if it was slowed)."""
+        if self._pos_poll_throttled:
+            self.sig_polling_stage_position_set_interval.emit(self._pos_poll_normal_ms)
+            self._pos_poll_throttled = False
+        self.sig_polling_stage_position_start.emit()
+
