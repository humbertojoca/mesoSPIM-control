@@ -39,6 +40,22 @@
         
         self.position_dict = {axis : None for axis in self.axis_list} # create an empty position dict
         self.asi_connection = serial.Serial(self.port, self.baudrate, parity=serial.PARITY_NONE, timeout=5, xonxoff=False, stopbits=serial.STOPBITS_ONE)
+        # Guards every read/write on self.asi_connection. Added after a
+        # real-hardware finding (see PATCHNOTES_ASI_TIGER.md in the
+        # ASI Tiger integration project): when something else shares
+        # this exact connection (an ASI Tiger rack is ONE physical
+        # serial port behind many logical cards -- stage, DAC, PLC),
+        # e.g. mesoSPIM_ASITigerWaveFormGenerator.from_open_serial()'s
+        # shared-connection path, there was previously NO lock here at
+        # all -- so this driver's own stage-position-polling (which
+        # runs on a GUI-thread timer, concurrently with whatever else
+        # is using the port) could interleave its write()/readline()
+        # with a different thread's, corrupting both sides' replies.
+        # Exposed as a public attribute (not a private `_lock`) so
+        # another driver sharing this connection can pass the SAME
+        # lock object into its own commands instead of only guarding
+        # itself -- see TigerController.from_open_serial(lock=...).
+        self.serial_lock = threading.Lock()
         self.previous_command = ''
         if self.read_position() is None:
             raise ValueError('Could not connect to ASI stage')
